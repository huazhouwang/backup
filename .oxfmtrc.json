{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortImports": {},
  "sortPackageJson": true,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/*.gen.ts",
    "packages/ui/src/components/motion/**",
    "packages/ui/src/components/charts/**",
    "packages/ui/src/lib/**",
    "**/worker-configuration.d.ts"
  ]
}
