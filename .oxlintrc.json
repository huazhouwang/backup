{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "react/jsx-no-literals": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.output/**",
    "**/.wrangler/**",
    "**/*.gen.ts",
    ".claude/**",
    "packages/ui/src/components/motion/**",
    "packages/ui/src/components/charts/**",
    "packages/ui/src/lib/**",
    "**/worker-configuration.d.ts",
    "apps/web/src/paraglide/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/test/**/*.ts", "e2e/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["apps/web/src/components/**", "packages/ui/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**", "**/app/**", "**/routes/**", "@folio/web"],
                "message": "Generic UI (packages/ui, apps/web/src/components) doesn't reach into features, routes or the app shell."
              }
            ]
          }
        ]
      }
    }
  ]
}
