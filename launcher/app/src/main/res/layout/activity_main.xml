<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 = Bento 仪表盘：纯色页面铺满卡片。
  上排：时钟卡 | GPS 卡（车速 + 日出日落弧线）| CarPlay 大卡（左边方块是当前壁纸）。
  下排：应用卡（原车、常用应用、添加、全部应用、桌面设置），多了可以左右滑。
  壁纸只在 CarPlay 卡里完整显示，页面背景里只淡淡透一点。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 页面背景里很淡的一层壁纸（上面盖一层主题色）。 -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 在线壁纸的摄影师署名（Unsplash 要求）。 -->
    <TextView
        android:id="@+id/credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="3dp"
        android:singleLine="true"
        android:textSize="10sp"
        android:fontFamily="@font/outfit_regular"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/topRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:orientation="horizontal">

            <!-- 时钟卡（不可点：在上面左右滑也能滚动下排）。 -->
            <LinearLayout
                android:id="@+id/clockCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="64sp"
                    android:fontFamily="@font/outfit_light"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <!-- 日期固定用中文显示，不跟随系统语言（车机可能是英文系统）。 -->
                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_regular"
                    android:letterSpacing="0.04" />

                <!-- 有新版本时显示，点了进设置的"版本更新"。 -->
                <TextView
                    android:id="@+id/pillUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- GPS 卡：车速大字、方向 / 海拔、日出日落弧线（不可点）。 -->
            <LinearLayout
                android:id="@+id/gpsCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/gpsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="40sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.03"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/speedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="4dp"
                        android:singleLine="true"
                        android:text="km/h"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />
                </LinearLayout>

                <!-- 方向 · 海拔；没有定位时是提示文字。 -->
                <TextView
                    android:id="@+id/trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />

                <FrameLayout
                    android:id="@+id/sunHolder"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- CarPlay 大卡：左边方块是当前壁纸（像音乐卡片的封面）。 -->
            <LinearLayout
                android:id="@+id/firstTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginStart="16dp"
                android:orientation="horizontal"
                android:padding="14dp"
                android:focusable="true"
                android:clickable="true"
                android:focusedByDefault="true">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:paddingEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/carplayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.16"
                        android:textAllCaps="true" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/carplayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/carplay"
                        android:textSize="34sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/carplaySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- 进入按钮：圆形，深色底 + 箭头。 -->
                    <ImageView
                        android:id="@+id/carplayGo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:padding="13dp"
                        android:src="@drawable/ui_right"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 下排：应用卡。 -->
        <HorizontalScrollView
            android:id="@+id/tileScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
