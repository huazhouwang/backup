<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Q5Home" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorAccent">#FF8EF0B0</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:alertDialogTheme">@style/Dialog.Q5Home</item>
    </style>

    <style name="Dialog.Q5Home" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF8EF0B0</item>
    </style>

    <!-- 磨砂胶囊按钮，tvOS 风格（参考 CleanYourTV）。 -->
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
