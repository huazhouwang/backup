            "north",
            "south",
            "east",
            "west",
          ],
          "type": "string",
        },
        "distance": {
          "description": "Distance to move (mm)",
          "type": "number",
        },
        "to": {
          "description": "Move directly to a coordinate: y for east-west walls, x for north-south walls",
          "type": "number",
        },
        "wall": {
          "description": "ID or name of the wall (names may take a level prefix, e.g. “Level 2·Bedroom” or “二层·主卧”)",
          "type": "string",
        },
      },
      "required": [
