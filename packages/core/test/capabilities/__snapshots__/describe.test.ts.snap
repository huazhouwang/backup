  {
    "description": "Read the recipe that draws a target in this design (its look, or the default one) or a look by ID or name, with the size it is usually built at and its parameters (what params_set can change per object). Start from it to change what something looks like.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "look": {
          "description": "Look ID or name",
          "type": "string",
        },
        "target": {
          "description": "What a look draws: 'furniture:<type>' (a furniture type), 'opening:<door|sliding-door|gate|window|opening|glass-block>', 'element:<stair|pond|drain>' or 'wall:railing'",
          "pattern": "^(furniture|opening|element|wall):[A-Za-z0-9_-]+$",
          "type": "string",
        },
      },
      "type": "object",
    },
    "kind": "query",
