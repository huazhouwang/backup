{
  "$schema": "apps/api/node_modules/wrangler/config-schema.json",
  "name": "lullabo",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA and the API share one origin: static assets are served without invoking the
  // Worker (free and fast); only /api/* runs Worker code.
  "assets": {
    "directory": "apps/web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bobo-db",
      // Placeholder: the deploy workflow (or the Deploy to Cloudflare button) creates the
      // database if needed and fills in its id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/api/migrations",
    },
  ],
  // Speech to text for the chat box's microphone.
  "ai": { "binding": "AI" },
  // Auth endpoint limits (src/rate-limit.ts). namespace_id must be unique in the account.
  "ratelimits": [
    {
      "name": "AUTH_EMAIL_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "AUTH_IP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    // Siri voice commands per code (src/routes/voice.ts).
    {
      "name": "VOICE_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    // The chat's live recognition while someone talks: a request every second or two.
    {
      "name": "SPEECH_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 40, "period": 60 },
    },
  ],
  // To send email with Cloudflare Email Service (Workers Paid plan), add:
  //   "send_email": [{ "name": "EMAIL" }]
  // On the free plan, set the RESEND_API_KEY secret instead. Both need EMAIL_FROM.
  // Reminder dispatch (src/reminders.ts).
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
